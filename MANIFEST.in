include README.md
include LICENSE
include pyproject.toml
include setup.py
include CMakeLists.txt

recursive-include native CMakeLists.txt *.cpp *.hpp *.cu *.cuh
recursive-include src/py2sess/data/benchmark *.npz
recursive-include benchmarks README.md *.csv *.nc *.npz *.yaml
recursive-include docs *.md *.tex *.txt *.bst *.cfg *.cls *.sty *.pdf
recursive-include examples *.py
recursive-include scripts *.py *.sh *.md
recursive-include skills *.md
recursive-include tests *.py

prune build
prune dist
prune outputs
prune benchmark_bundles
prune .git
prune .pytest_cache
prune .mypy_cache

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
